# Environment Configuration for Municipal Cemetery Management System (San Carlos & Cachapoal)

# Application Settings
ENVIRONMENT=development
DEBUG=True
APP_NAME="Sistema de Gestión Cementerios Municipales San Carlos y Cachapoal"
APP_VERSION=1.0.0
SECRET_KEY=change-this-ultra-secure-secret-key-for-production-min-32-chars-hex
API_V1_STR=/api/v1

# Security & Cryptographic Audit
AUDIT_HMAC_SECRET=cemetery-hmac-sha256-audit-secret-key-32bytes-min
TOTP_ISSUER="Cementerio Municipal San Carlos"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration (PostgreSQL 16 with schemas: core, staging, migration, audit)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=cem_admin
POSTGRES_PASSWORD=cem_secure_password_2026
POSTGRES_DB=cem_db
DATABASE_URL=postgresql+psycopg2://cem_admin:cem_secure_password_2026@localhost:5432/cem_db
ASYNC_DATABASE_URL=postgresql+asyncpg://cem_admin:cem_secure_password_2026@localhost:5432/cem_db

# S3 / Object Storage (Burial permits, deeds, receipts - AES-256)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minio_admin
S3_SECRET_KEY=minio_secure_password_2026
S3_BUCKET_NAME=cementerio-documentos
S3_REGION=us-east-1

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_DEFAULT_LOCALE=es
